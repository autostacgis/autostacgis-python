{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autostacgis.github.io/autostacgis/v0.0.1/schemas/workflow.json",
  "title": "Capability-grouped workflow",
  "type": "object",
  "properties": {
    "trigger": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      },
      "maxProperties": 1
    },
    "metadata_in": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "data_in": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "sequence": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "encode": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "data_out": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "data_transfer": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "metadata_out": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object"
          },
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object"
            }
          }
        ]
      },
      "minProperties": 1
    },
    "solver": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      },
      "minProperties": 1,
      "maxProperties": 1
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "metadata_structure": {
      "type": "object",
      "properties": {
        "schemas": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "uniqueItems": true
        },
        "inline": {
          "type": "object"
        },
        "strict": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "query": {
          "type": "object"
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "sequence": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "plugin": {
                    "type": "string",
                    "minLength": 1
                  },
                  "settings": {
                    "type": "object"
                  },
                  "scope": {
                    "enum": [
                      "inventory",
                      "available"
                    ]
                  }
                },
                "required": [
                  "plugin"
                ],
                "additionalProperties": false
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "plugin": {
                      "type": "string",
                      "minLength": 1
                    },
                    "settings": {
                      "type": "object"
                    },
                    "scope": {
                      "enum": [
                        "inventory",
                        "available"
                      ]
                    }
                  },
                  "required": [
                    "plugin"
                  ],
                  "additionalProperties": false
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "work_directory": {
          "type": "string",
          "minLength": 1
        },
        "data_transfer": {
          "type": "object",
          "properties": {
            "plugin": {
              "type": "string",
              "minLength": 1
            },
            "settings": {
              "type": "object"
            }
          },
          "required": [
            "plugin"
          ],
          "additionalProperties": false
        },
        "checkpoint": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "plugin": {
                  "type": "string",
                  "minLength": 1
                },
                "settings": {
                  "type": "object"
                }
              },
              "required": [
                "plugin"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "discovery": {
          "type": "boolean"
        },
        "steps": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "plugin": {
                    "type": "string",
                    "minLength": 1
                  },
                  "settings": {
                    "type": "object"
                  },
                  "sequence": {
                    "type": "object",
                    "additionalProperties": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "plugin": {
                              "type": "string",
                              "minLength": 1
                            },
                            "settings": {
                              "type": "object"
                            },
                            "scope": {
                              "enum": [
                                "inventory",
                                "available"
                              ]
                            }
                          },
                          "required": [
                            "plugin"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "object",
                            "properties": {
                              "plugin": {
                                "type": "string",
                                "minLength": 1
                              },
                              "settings": {
                                "type": "object"
                              },
                              "scope": {
                                "enum": [
                                  "inventory",
                                  "available"
                                ]
                              }
                            },
                            "required": [
                              "plugin"
                            ],
                            "additionalProperties": false
                          }
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "transfer": {
                    "enum": [
                      "memory",
                      "file",
                      "optimized"
                    ]
                  },
                  "checkpoint": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "plugin": {
                            "type": "string",
                            "minLength": 1
                          },
                          "settings": {
                            "type": "object"
                          }
                        },
                        "required": [
                          "plugin"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "inputs": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "pattern": "^result:"
                    }
                  },
                  "outputs": {
                    "type": "object",
                    "additionalProperties": {
                      "oneOf": [
                        {
                          "type": "string",
                          "pattern": "^path:.+"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "save": {
                              "type": "boolean",
                              "default": false,
                              "description": "Save this result through its encoder and destination. Independent of the goal."
                            },
                            "encode": {
                              "oneOf": [
                                {
                                  "type": "object",
                                  "properties": {
                                    "plugin": {
                                      "type": "string",
                                      "minLength": 1
                                    },
                                    "settings": {
                                      "type": "object"
                                    }
                                  },
                                  "required": [
                                    "plugin"
                                  ],
                                  "additionalProperties": false
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "data_out": {
                              "type": "object",
                              "properties": {
                                "plugin": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "settings": {
                                  "type": "object"
                                }
                              },
                              "required": [
                                "plugin"
                              ],
                              "additionalProperties": false
                            },
                            "metadata_out": {
                              "oneOf": [
                                {
                                  "type": "object",
                                  "properties": {
                                    "plugin": {
                                      "type": "string",
                                      "minLength": 1
                                    },
                                    "settings": {
                                      "type": "object"
                                    }
                                  },
                                  "required": [
                                    "plugin"
                                  ],
                                  "additionalProperties": false
                                },
                                {
                                  "type": "array",
                                  "items": {
                                    "type": "object",
                                    "properties": {
                                      "plugin": {
                                        "type": "string",
                                        "minLength": 1
                                      },
                                      "settings": {
                                        "type": "object"
                                      }
                                    },
                                    "required": [
                                      "plugin"
                                    ],
                                    "additionalProperties": false
                                  }
                                }
                              ]
                            },
                            "filename_suffixes": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                              },
                              "description": "Append these filename tokens to this output asset's history."
                            },
                            "output_directory": {
                              "oneOf": [
                                {
                                  "type": "string",
                                  "minLength": 1
                                },
                                {
                                  "type": "object",
                                  "properties": {
                                    "jsonata": {
                                      "type": "string",
                                      "minLength": 1
                                    }
                                  },
                                  "required": [
                                    "jsonata"
                                  ],
                                  "additionalProperties": false
                                },
                                {
                                  "type": "null"
                                }
                              ],
                              "description": "Preferred Item output directory, set literally or from JSONata. Does not enable saving."
                            },
                            "transfer": {
                              "enum": [
                                "memory",
                                "file",
                                "optimized"
                              ]
                            }
                          },
                          "required": [],
                          "additionalProperties": false
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "plugin"
                ],
                "additionalProperties": false,
                "patternProperties": {
                  "^param:.+": {}
                }
              },
              {
                "type": "object",
                "properties": {
                  "auto": {
                    "const": true
                  }
                },
                "required": [
                  "auto"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "solver",
    "goal"
  ],
  "additionalProperties": false
}
