{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autostacgis.github.io/autostacgis/v0.0.1/schemas/catalog.json",
  "type": "object",
  "properties": {
    "version": {
      "const": "0.0.1"
    },
    "plugins": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "https://autostacgis.github.io/autostacgis/v0.0.1/schemas/plugin.json"
          },
          {
            "type": "object",
            "properties": {
              "use": {
                "type": "string",
                "minLength": 1
              },
              "settings": {
                "type": "object"
              },
              "execution": {
                "type": "object",
                "properties": {
                  "transfer": {
                    "enum": [
                      "memory",
                      "file",
                      "optimized"
                    ]
                  },
                  "checkpoint": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "plugin": {
                            "type": "string",
                            "minLength": 1
                          },
                          "settings": {
                            "type": "object"
                          }
                        },
                        "required": [
                          "plugin"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "outputs": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "save": {
                          "type": "boolean",
                          "default": false,
                          "description": "Save this result through its encoder and destination. Independent of the goal."
                        },
                        "encode": {
                          "oneOf": [
                            {
                              "type": "object",
                              "properties": {
                                "plugin": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "settings": {
                                  "type": "object"
                                }
                              },
                              "required": [
                                "plugin"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "data_out": {
                          "type": "object",
                          "properties": {
                            "plugin": {
                              "type": "string",
                              "minLength": 1
                            },
                            "settings": {
                              "type": "object"
                            }
                          },
                          "required": [
                            "plugin"
                          ],
                          "additionalProperties": false
                        },
                        "metadata_out": {
                          "oneOf": [
                            {
                              "type": "object",
                              "properties": {
                                "plugin": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "settings": {
                                  "type": "object"
                                }
                              },
                              "required": [
                                "plugin"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "plugin": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "settings": {
                                    "type": "object"
                                  }
                                },
                                "required": [
                                  "plugin"
                                ],
                                "additionalProperties": false
                              }
                            }
                          ]
                        },
                        "filename_suffixes": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                          },
                          "description": "Append these filename tokens to this output asset's history."
                        },
                        "output_directory": {
                          "oneOf": [
                            {
                              "type": "string",
                              "minLength": 1
                            },
                            {
                              "type": "object",
                              "properties": {
                                "jsonata": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              },
                              "required": [
                                "jsonata"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "Preferred Item output directory, set literally or from JSONata. Does not enable saving."
                        },
                        "transfer": {
                          "enum": [
                            "memory",
                            "file",
                            "optimized"
                          ]
                        }
                      },
                      "required": [],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [],
                "additionalProperties": false
              }
            },
            "required": [
              "use"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "defaults": {
      "type": "object",
      "properties": {
        "data_transfer": {
          "type": "object",
          "properties": {
            "plugin": {
              "type": "string",
              "minLength": 1
            },
            "settings": {
              "type": "object"
            }
          },
          "required": [
            "plugin"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object"
    },
    "solver": {
      "type": "object",
      "properties": {
        "plugin": {
          "type": "string",
          "minLength": 1
        },
        "settings": {
          "type": "object"
        }
      },
      "required": [
        "plugin"
      ],
      "additionalProperties": false
    },
    "extension_schemas": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "version",
    "plugins"
  ],
  "additionalProperties": false
}
