{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autostacgis.github.io/autostacgis/v1.0.0/schemas/request.json",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "goal": {
      "$ref": "https://autostacgis.github.io/autostacgis/v1.0.0/schemas/goal.json"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "query": {
      "type": "object"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "module_settings": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "sequence": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "plugin": {
                "type": "string",
                "minLength": 1
              },
              "settings": {
                "type": "object"
              },
              "scope": {
                "enum": [
                  "inventory",
                  "available"
                ]
              }
            },
            "required": [
              "plugin"
            ],
            "additionalProperties": false
          },
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "plugin": {
                  "type": "string",
                  "minLength": 1
                },
                "settings": {
                  "type": "object"
                },
                "scope": {
                  "enum": [
                    "inventory",
                    "available"
                  ]
                }
              },
              "required": [
                "plugin"
              ],
              "additionalProperties": false
            }
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "solver": {
      "type": "object",
      "properties": {
        "max_steps": {
          "type": "integer",
          "minimum": 0
        },
        "max_states": {
          "type": "integer",
          "minimum": 1
        },
        "max_bindings": {
          "type": "integer",
          "minimum": 1
        },
        "timeout": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object"
    },
    "work_directory": {
      "type": "string",
      "minLength": 1
    },
    "data_transfer": {
      "type": "object",
      "properties": {
        "plugin": {
          "type": "string",
          "minLength": 1
        },
        "settings": {
          "type": "object"
        }
      },
      "required": [
        "plugin"
      ],
      "additionalProperties": false
    },
    "checkpoint": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "plugin": {
              "type": "string",
              "minLength": 1
            },
            "settings": {
              "type": "object"
            }
          },
          "required": [
            "plugin"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "discovery": {
      "type": "boolean"
    },
    "steps": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "plugin": {
                "type": "string",
                "minLength": 1
              },
              "settings": {
                "type": "object"
              },
              "sequence": {
                "type": "object",
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "plugin": {
                          "type": "string",
                          "minLength": 1
                        },
                        "settings": {
                          "type": "object"
                        },
                        "scope": {
                          "enum": [
                            "inventory",
                            "available"
                          ]
                        }
                      },
                      "required": [
                        "plugin"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "properties": {
                          "plugin": {
                            "type": "string",
                            "minLength": 1
                          },
                          "settings": {
                            "type": "object"
                          },
                          "scope": {
                            "enum": [
                              "inventory",
                              "available"
                            ]
                          }
                        },
                        "required": [
                          "plugin"
                        ],
                        "additionalProperties": false
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "transfer": {
                "enum": [
                  "memory",
                  "file",
                  "optimized"
                ]
              },
              "checkpoint": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "plugin": {
                        "type": "string",
                        "minLength": 1
                      },
                      "settings": {
                        "type": "object"
                      }
                    },
                    "required": [
                      "plugin"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "inputs": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^result:"
                }
              },
              "outputs": {
                "type": "object",
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^path:.+"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "publish": {
                          "type": "object",
                          "properties": {
                            "encode": {
                              "type": "object",
                              "properties": {
                                "plugin": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "settings": {
                                  "type": "object"
                                }
                              },
                              "required": [
                                "plugin"
                              ],
                              "additionalProperties": false
                            },
                            "data_out": {
                              "type": "object",
                              "properties": {
                                "plugin": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "settings": {
                                  "type": "object"
                                }
                              },
                              "required": [
                                "plugin"
                              ],
                              "additionalProperties": false
                            },
                            "metadata_out": {
                              "oneOf": [
                                {
                                  "type": "object",
                                  "properties": {
                                    "plugin": {
                                      "type": "string",
                                      "minLength": 1
                                    },
                                    "settings": {
                                      "type": "object"
                                    }
                                  },
                                  "required": [
                                    "plugin"
                                  ],
                                  "additionalProperties": false
                                },
                                {
                                  "type": "array",
                                  "items": {
                                    "type": "object",
                                    "properties": {
                                      "plugin": {
                                        "type": "string",
                                        "minLength": 1
                                      },
                                      "settings": {
                                        "type": "object"
                                      }
                                    },
                                    "required": [
                                      "plugin"
                                    ],
                                    "additionalProperties": false
                                  }
                                }
                              ]
                            }
                          },
                          "required": [],
                          "additionalProperties": false
                        },
                        "transfer": {
                          "enum": [
                            "memory",
                            "file",
                            "optimized"
                          ]
                        }
                      },
                      "required": [],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            },
            "required": [
              "plugin"
            ],
            "additionalProperties": false,
            "patternProperties": {
              "^param:.+": {}
            }
          },
          {
            "type": "object",
            "properties": {
              "auto": {
                "const": true
              }
            },
            "required": [
              "auto"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "goal"
  ],
  "additionalProperties": false
}
